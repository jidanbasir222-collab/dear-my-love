# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — DEAR MY LOVE (OUR LITTLE UNIVERSE)
# ==============================================================================
# Salin file ini menjadi `.env` untuk konfigurasi lokal, atau masukkan key-value
# ke halaman Settings > Environment Variables pada dashboard Vercel Anda.
# ==============================================================================

# 1. DATABASE (Wajib untuk Vercel / Cloud Deployment)
# URL koneksi PostgreSQL cloud (misalnya dari Neon.tech, Supabase, atau Vercel Postgres).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. AUTENTIKASI ADMIN (Wajib)
# Kunci rahasia untuk menandatangani token JWT sesi admin.
# Anda dapat menghasilkan string acak yang kuat (misal: jalankan `openssl rand -base64 32`).
JWT_SECRET="ganti_dengan_random_secret_panjang_minimal_32_karakter_untuk_keamanan"

# 3. PENYIMPANAN CLOUD FILE / MEDIA (Pilih salah satu untuk Vercel)
# Opsi A: Vercel Blob (Sangat direkomendasikan & terintegrasi otomatis di Vercel)
# Didapatkan di dashboard Vercel -> tab "Storage" -> Create "Blob Store".
BLOB_READ_WRITE_TOKEN=""

# Opsi B: Cloudinary (Alternatif jika menggunakan Cloudinary)
# Didapatkan dari dashboard Cloudinary (https://cloudinary.com/console).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
